<?xml version="1.0" encoding="utf-8"?>
<!--
  Ícono pequeño (barra de estado) con el logo de DocuSmart: documento, línea
  de escaneo y mira de 4 esquinas, mismos trazos que
  ic_launcher_docusmart_foreground. Android pinta este ícono solo con su canal
  alfa (silueta blanca), así que el documento se parte en dos mitades con un
  hueco para que la línea de escaneo se distinga. Reemplaza los glifos
  genéricos de calendario/nota en las notificaciones de recordatorio.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="52"
    android:viewportHeight="52">
    <group
        android:translateX="-28"
        android:translateY="-28">
        <!-- documento: mitad superior e inferior, con hueco para el escaneo -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M40,32h28a4,4 0 0 1 4,4v13h-36v-13a4,4 0 0 1 4,-4z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M36,59h36v13a4,4 0 0 1 -4,4h-28a4,4 0 0 1 -4,-4z" />

        <!-- línea de escaneo -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M34,52.5h40a1.75,1.75 0 0 1 0,3.5h-40a1.75,1.75 0 0 1 0,-3.5z" />

        <!-- mira: 4 esquinas -->
        <path
            android:pathData="M28,36v-4a3,3 0 0 1 3,-3h4"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="3.2" />
        <path
            android:pathData="M80,36v-4a3,3 0 0 0 -3,-3h-4"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="3.2" />
        <path
            android:pathData="M28,72v4a3,3 0 0 0 3,3h4"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="3.2" />
        <path
            android:pathData="M80,72v4a3,3 0 0 1 -3,3h-4"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="3.2" />
    </group>
</vector>
