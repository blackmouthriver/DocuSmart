<?xml version="1.0" encoding="utf-8"?>
<!--
  Ronda 16: la plantilla original de Android Studio dejaba este archivo vacio.
  allowBackup ya es false en el manifest, pero estas reglas quedan explicitas
  por si alguien lo reactiva: DocuSmart guarda el hash del PIN, la Carpeta
  Segura (cifrada con una clave del Keystore que NO se restaura en otro
  dispositivo, asi que el respaldo seria inservible), la base de datos y los
  documentos del usuario, nada de eso debe salir del dispositivo por un
  respaldo automatico.
  Aplica a API 30 y menor (API 31+ usa data_extraction_rules.xml).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
