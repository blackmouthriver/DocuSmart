<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Almacenamiento — API 32 y menor ───────────── -->
    <!-- Hallazgo real 2026-09-03 (fila 22, backlog-mejoras-ux-2026-08-30.md
         §14): antes topaba en maxSdkVersion=28, dejando API 29-32 sin este
         permiso pese a que en esas versiones SÍ es necesario y SÍ tiene
         efecto real para ver documentos de Descargas creados por otras
         apps (a diferencia de API 33+, donde este permiso ya no tiene
         ningún efecto — confirmado, no es una suposición). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- ── Almacenamiento — API 29 a 32 ─────────────── -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />

    <!-- ── Medios — Android 13+ (API 33+): NINGÚN permiso de medios ── -->
    <!-- READ_MEDIA_VIDEO y READ_MEDIA_AUDIO removidos 2026-09-10 y
         READ_MEDIA_IMAGES / READ_MEDIA_VISUAL_USER_SELECTED removidos
         2026-10-14: la revisión de producción de Play Console los marcó
         ("Usar selectores de sistema alternativos para fotos o vídeos").
         DocuSmart no es una galería ni un editor de fotos: las imágenes
         entran siempre por el selector del sistema (OpenDocument /
         PickVisualMedia), que no necesita permiso. La Biblioteca ya no
         lista las fotos de la galería; sí sigue mostrando lo que genera
         la app (MediaStore devuelve las filas propias sin permiso). -->
    <!-- android.permission.READ_MEDIA_DOCUMENTS — ELIMINADO 2026-09-03:
         no existe como permiso real de Android (confirmado). Documentos
         (PDF/Word/Excel/PowerPoint/Texto) de otras apps en Descargas no
         tienen ningún permiso equivalente a READ_MEDIA_IMAGES en API 33+
         — solo Storage Access Framework (ACTION_OPEN_DOCUMENT, ya usado
         por "Desde el dispositivo") o MANAGE_EXTERNAL_STORAGE (acceso a
         todos los archivos, restringido por política de Play Store, no
         solicitado a propósito). Ver
         backlog-mejoras-ux-2026-08-30.md §16/fila 22 para el detalle. -->
    <!-- ── Requerido por AdMob ───────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- La actividad del escáner de ML Kit fuerza orientación vertical y eso añade
         screen.portrait como obligatorio, lo que excluye tablets, Chromebooks y
         Android XR solo-horizontal (aviso de Play Console al subir la 1.1.6). La app
         funciona en horizontal, así que se declara opcional. -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <!-- ── Pomodoro en segundo plano (RF-STU-10) ─────── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- ── Agenda + Notas — recordatorios exactos (HU-65, #52) ── -->
    <!-- Decisión de producto explícita del usuario (2026-09-16): alarma
         EXACTA en vez de WorkManager, para que el recordatorio suene justo
         a la hora del evento. En Android 12+ (API 31) este permiso no se
         concede solo — el usuario puede negarlo/revocarlo desde Ajustes
         del sistema; ReminderScheduler.kt/NoteReminderScheduler.kt se
         degradan a una alarma inexacta si no está concedido, en vez de no
         recordar nada. Un único permiso a nivel de manifest cubre ambos
         schedulers — no hace falta declararlo dos veces. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Reprogramar los recordatorios pendientes (Agenda y Notas) tras un
         reinicio del dispositivo (AlarmManager pierde todas sus alarmas al
         apagarse), ver BootRescheduleReceiver.kt. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".DocuSmartApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_docusmart"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_docusmart_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Docsmart"
        android:enableOnBackInvokedCallback="true">


        <!-- AdMob App ID real, registrado 2026-09-10 en apps.admob.com -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-1109506701099935~4980986590" />

        <!-- Firebase Analytics/Crashlytics: activados solo en el build type
             release (ver manifestPlaceholders en app/build.gradle.kts); en
             debug, ningún dato de desarrollo/pruebas llega a Firebase. -->
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="${firebaseAnalyticsDeactivated}" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="${firebaseCrashlyticsEnabled}" />
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Docsmart"
            android:windowSoftInputMode="adjustResize">

            <!-- ── Launcher principal ────────────────── -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

