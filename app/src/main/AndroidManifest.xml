<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Almacenamiento — API 32 y menor ───────────── -->
    <!-- Hallazgo real 2026-09-03 (fila 22, backlog-mejoras-ux-2026-08-30.md
         §14): antes topaba en maxSdkVersion=28, dejando API 29-32 sin este
         permiso pese a que en esas versiones SÍ es necesario y SÍ tiene
         efecto real para ver documentos de Descargas creados por otras
         apps (a diferencia de API 33+, donde este permiso ya no tiene
         ningún efecto — confirmado, no es una suposición). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- ── Almacenamiento — API 29 a 32 ─────────────── -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />

    <!-- ── Medios — Android 13+ (API 33+) ───────────── -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        android:minSdkVersion="34" />
    <!-- android.permission.READ_MEDIA_DOCUMENTS — ELIMINADO 2026-09-03:
         no existe como permiso real de Android (confirmado). Documentos
         (PDF/Word/Excel/PowerPoint/Texto) de otras apps en Descargas no
         tienen ningún permiso equivalente a READ_MEDIA_IMAGES en API 33+
         — solo Storage Access Framework (ACTION_OPEN_DOCUMENT, ya usado
         por "Desde el dispositivo") o MANAGE_EXTERNAL_STORAGE (acceso a
         todos los archivos, restringido por política de Play Store, no
         solicitado a propósito). Ver
         backlog-mejoras-ux-2026-08-30.md §16/fila 22 para el detalle. -->
    <!-- ── Requerido por AdMob ───────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- ── Pomodoro en segundo plano (RF-STU-10) ─────── -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".DocuSmartApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_docusmart"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_docusmart_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Docsmart"
        android:enableOnBackInvokedCallback="true">


        <!-- AdMob App ID — reemplazar con el tuyo al publicar -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Docsmart"
            android:windowSoftInputMode="adjustResize">

            <!-- ── Launcher principal ────────────────── -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ── Abrir PDF desde otras apps ────────── -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- ── Abrir imágenes desde otras apps ───── -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- ── Abrir Word desde otras apps ───────── -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/msword" />
            </intent-filter>
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
            </intent-filter>

            <!-- ── Abrir Excel desde otras apps ──────── -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.ms-excel" />
            </intent-filter>
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </intent-filter>

            <!-- ── Abrir PowerPoint desde otras apps ─── -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
            </intent-filter>
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
            </intent-filter>

        </activity>

        <!-- RF-STU-10: mantiene el Pomodoro corriendo aunque se navegue
             fuera de Modo Estudio o la app pase a segundo plano. No encaja
             en ningún foregroundServiceType estándar (no es dataSync,
             mediaPlayback, location, etc.); "specialUse" es el tipo
             reservado exactamente para este caso, exige declarar el motivo
             en PROPERTY_SPECIAL_USE_FGS_SUBTYPE. -->
        <service
            android:name=".features.study.domain.PomodoroTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="pomodoro_study_timer" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>

</manifest>